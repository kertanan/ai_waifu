# ============================================
# AI Waifu Project - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- LM Studio / LLM Configuration ---
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_MODEL=ibm/granite-4-micro
LM_API_TOKEN=your-api-token-here

# --- Server Configuration ---
API_HOST=127.0.0.1
API_PORT=8080

# --- Flask Backend ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# --- VOICEVOX / VoiceFox TTS ---
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=8

# --- VTube Studio ---
VTUBE_STUDIO_TOKEN_PATH=./token.txt

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
