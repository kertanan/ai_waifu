# ============================================
# AI Waifu Project - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- LM Studio / LLM Configuration ---
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_MODEL=qwen/qwen3-4b-2507
LM_API_TOKEN=your-api-token-here

# --- Server Configuration ---
API_HOST=127.0.0.1
API_PORT=8080

# --- Flask Backend ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# --- VOICEVOX / VoiceFox TTS ---
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=8

# --- GPT-SoVITS (suara hasil training) ---
# TTS_ENGINE=sovits -> pakai GPT-SoVITS, otomatis fallback ke VOICEVOX kalau gagal
TTS_ENGINE=sovits
SOVITS_URL=http://127.0.0.1:9880
SOVITS_MODEL_DIR=voice_model/char001/output
SOVITS_TEXT_LANG=ja

# --- VTube Studio ---
VTUBE_STUDIO_TOKEN_PATH=./token.txt

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
